<% content_for :title, "Plans · Sofenx AI Store Auditor" %>

<div class="app-shell">
  <header class="topbar">
    <div class="brand-lockup"><span class="brand-mark" aria-hidden="true">S</span><div><strong>AI Store Auditor</strong><span>Plans</span></div></div>
    <nav class="topnav" aria-label="App navigation">
      <%= link_to "Dashboard", with_shopify_navigation_params(root_path) %>
      <%= link_to "Plans", with_shopify_navigation_params(plans_path), class: "active" %>
      <%= link_to "Settings", with_shopify_navigation_params(edit_settings_path) %>
    </nav>
  </header>

  <main class="page-stack">
    <section class="hero-row compact">
      <div>
        <p class="eyebrow">Simple monthly pricing</p>
        <h1>Choose how often you want a fresh action plan.</h1>
        <p class="lede">Every paid plan includes a 7-day trial for first-time subscribers, with one audit total during the trial. Charges and plan changes are approved securely in Shopify.</p>
      </div>
    </section>

    <% flash.each do |type, message| %><div class="banner <%= type == 'alert' ? 'banner-critical' : 'banner-success' %>"><%= message %></div><% end %>
    <% if @billing_error.present? %><div class="banner banner-critical"><strong>Billing status is temporarily unavailable.</strong><span><%= @billing_error %></span></div><% end %>

    <% if current_shop.billing_active? %>
      <section class="banner banner-info plan-status">
        <div>
          <strong><%= current_shop.billing_plan.name %> is active<%= " (test charge)" if current_shop.billing_test? %></strong>
          <span><%= current_shop.audits_used %> of <%= current_shop.audit_limit %> audits used <%= current_shop.billing_trial? ? "during the introductory trial" : "in the current 30-day period" %>.</span>
        </div>
        <span class="usage-pill"><%= current_shop.audits_remaining %> remaining</span>
      </section>
    <% elsif current_shop.billing_status == "unrecognized" %>
      <section class="banner banner-critical"><strong>This store has an older Shopify subscription we cannot map to a current plan.</strong><span>Please contact support before changing it.</span></section>
    <% else %>
      <section class="banner banner-info plan-status">
        <div><strong>Free is active</strong><span><%= current_shop.audits_used %> of <%= BillingPlan.free.audit_limit %> audits used in the current 30-day period.</span></div>
        <span class="usage-pill"><%= current_shop.audits_remaining %> remaining</span>
      </section>
    <% end %>

    <section class="plan-grid" aria-label="Subscription plans">
      <% @plans.each do |plan| %>
        <% current = plan.key == "free" ? !current_shop.billing_active? : current_shop.billing_active? && current_shop.billing_plan_key == plan.key %>
        <article class="card plan-card <%= 'plan-card-featured' if plan.key == 'growth' %>">
          <% if plan.key == "growth" %><span class="popular-badge">Most popular</span><% end %>
          <p class="eyebrow"><%= plan.name %></p>
          <h2><span>$<%= plan.price %></span> / month</h2>
          <p class="plan-description"><%= plan.description %></p>
          <ul><% plan.features.each do |feature| %><li><%= feature %></li><% end %></ul>
          <% if current %>
            <button class="button button-secondary" disabled>Current plan</button>
          <% elsif plan.key == "free" %>
            <%= button_to "Downgrade to Free", with_shopify_navigation_params(billing_subscription_path),
              method: :delete,
              class: "button button-secondary",
              form: { data: { turbo_confirm: "Cancel your paid subscription and switch to Free now? Your paid features will end immediately." } } %>
          <% else %>
            <%= button_to(current_shop.billing_active? ? "Switch to #{plan.name}" : "Start 7-day trial", with_shopify_navigation_params(billing_subscription_path),
              method: :post, params: { plan: plan.key }, class: "button button-primary") %>
          <% end %>
        </article>
      <% end %>

    </section>

    <p class="billing-footnote">The introductory trial includes one audit total across all plan selections. After the trial, audit allowances reset every 30 days. Failed audits do not use an allowance. Shopify handles paid charges and paid plan-change approval. Downgrading to Free ends paid access immediately and does not issue a prorated refund.</p>
  </main>
</div>

# Public app identity
HOST=https://your-app.example.com
SHOPIFY_APP_URL=https://your-app.example.com
SHOPIFY_APP_NAME=Sofenx AI Store Auditor
SHOPIFY_API_KEY=replace-me
SHOPIFY_API_SECRET=replace-me
SHOPIFY_APP_SCOPES=read_products,read_online_store_navigation
SHOPIFY_ADMIN_API_VERSION=2026-07
SHOPIFY_EMBEDDED_APP=true
SHOPIFY_MANAGED_WEBHOOKS=false
SHOPIFY_EXPIRING_OFFLINE_ACCESS_TOKENS=true

# Optional AI enrichment. Deterministic audits work without these.
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-5.6-terra

# Production runtime
DB_HOST=127.0.0.1
AI_STORE_AUDITOR_DATABASE_PASSWORD=replace-me
SOLID_QUEUE_IN_PUMA=false
JOB_CONCURRENCY=1
